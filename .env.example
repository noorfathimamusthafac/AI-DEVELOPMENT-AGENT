# Security
SECRET_KEY=super-secret-jwt-key-for-dev-agent-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./dev_agent.db

# OpenProject Configuration
OPENPROJECT_URL=https://your-openproject.example.com
OPENPROJECT_API_KEY=your_openproject_api_v3_key
# Set to true for local standalone testing with pre-loaded tickets BUG-101, FEAT-102
OPENPROJECT_MOCK_MODE=true

# Target Repository to be manipulated by the Agent
TARGET_REPO_PATH=./test-repository

# Optional LLM API Keys (Falls back to internal heuristics if left empty)
LLM_PROVIDER=auto
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
